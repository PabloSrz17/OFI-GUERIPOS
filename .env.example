# Copia este archivo como .env y ajusta los valores.
PORT=3000
# 0.0.0.0 = accesible desde otros equipos de la red Wi-Fi (http://IP-DE-ESTA-PC:3000)
HOST=0.0.0.0
DB_PATH=./data/database.sqlite
# Hora del respaldo diario en data/respaldos/ (también se hace en cada Cierre de Jornada)
RESPALDO_HORA=18

# --- Pulpos (robot) ---
# Antes de activarlo, inicia sesión una vez con: npm run pulpos:login
PULPOS_ACTIVO=false
PULPOS_INTERVALO_MIN=3
# true = sólo ventas con "Envío a Domicilio"; false = también las de recoger en tienda
PULPOS_SOLO_ENVIOS=true

# --- WhatsApp (avisos al cliente) ---
# Al activarlo, vincula el número del negocio escaneando el QR en http://localhost:3000/whatsapp.html
WHATSAPP_ACTIVO=false
WHATSAPP_NEGOCIO=Materiales El Güero
# Grupo del equipo donde contestan los agentes (Edgar, Chatito, Sulema, Octavio)
WHATSAPP_GRUPO_AGENTES=AGENTES IA CHAT

# --- SICAR (MySQL en la PC MOSTRADOR) ---
# Usuario de SÓLO LECTURA creado para la Oficina Virtual (ver README).
SICAR_ACTIVO=false
SICAR_INTERVALO_MIN=2
SICAR_DB_HOST=192.168.1.67
SICAR_DB_PORT=3306
SICAR_DB_NAME=sicar
SICAR_DB_USER=
SICAR_DB_PASSWORD=

# --- Google Sheets (registro de entregas) ---
# Ver scripts/google-sheets/Codigo.gs. SHEETS_TOKEN: contraseña larga y aleatoria; SHEETS_URL: URL de la aplicación web.
SHEETS_TOKEN=
SHEETS_URL=

# --- IA de los agentes (Claude Haiku) ---
# Clave de https://console.anthropic.com (API Keys)
ANTHROPIC_API_KEY=
