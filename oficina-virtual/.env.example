# Copia este archivo como .env y ajusta los valores.
PORT=3000
# 0.0.0.0 = accesible desde otros equipos de la red Wi-Fi (http://IP-DE-ESTA-PC:3000)
HOST=0.0.0.0
DB_PATH=./data/database.sqlite
# Hora del respaldo diario en data/respaldos/ (también se hace en cada Cierre de Jornada)
RESPALDO_HORA=18

# --- Dos servidores: Principal (esta PC) y Mostrador ---
# primary = Oficina completa + Chatito (fuente principal). secondary = PC de Mostrador: trabaja aunque el
# Principal esté apagado y se sincroniza con él solo. Ver scripts/mostrador/LEEME.txt
SERVER_ROLE=primary
# Chatito y todo lo que usa el WhatsApp del negocio. En Mostrador: false (no duplica la sesión de WhatsApp).
# Si no se pone, en el Principal vale lo de WHATSAPP_ACTIVO.
ENABLE_CHATITO=true
# Dirección del OTRO servidor (en el Principal, la del Mostrador; en el Mostrador, la del Principal).
PEER_SERVER_URL=
# Contraseña larga, la MISMA en los dos .env (la genera "npm run mostrador:paquete").
SYNC_TOKEN=
# Cada cuántos segundos se piden los cambios al otro servidor.
SYNC_INTERVALO_SEG=15
# Mostrador: se actualiza solo con el programa del Principal (revisa cada AUTO_ACTUALIZAR_MIN minutos).
AUTO_ACTUALIZAR=
AUTO_ACTUALIZAR_MIN=2
# Boton "Punto de Venta": abre (o trae al frente) una ventana que imprime directo. De fabrica solo en Mostrador.
POS_VENTANA=
POS_IMPRESORA=WL88S
# Conector del Punto de Venta: notas con envío al tablero, gasolina de la caja a Edgar, rescates de Sulema.
# Apagado hasta que se diga. Al encenderlo, apaga PULPOS_ACTIVO para no traer la misma venta dos veces.
POS_CONECTOR_ACTIVO=false
POS_CONECTOR_INTERVALO_MIN=1

# --- Pulpos (robot) ---
# Antes de activarlo, inicia sesión una vez con: npm run pulpos:login
PULPOS_ACTIVO=false
PULPOS_INTERVALO_MIN=3
# true = sólo ventas con "Envío a Domicilio"; false = también las de recoger en tienda
PULPOS_SOLO_ENVIOS=true

# --- WhatsApp (avisos al cliente) ---
# Al activarlo, vincula el número del negocio escaneando el QR en http://localhost:3000/whatsapp.html
WHATSAPP_ACTIVO=false
WHATSAPP_NEGOCIO=Materiales El Güero
# Grupo del equipo donde contestan los agentes (Edgar, Chatito, Sulema, Max)
WHATSAPP_GRUPO_AGENTES=AGENTES IA CHAT

# --- SICAR (MySQL en la PC MOSTRADOR) ---
# Usuario de SÓLO LECTURA creado para la Oficina Virtual (ver README).
SICAR_ACTIVO=false
SICAR_INTERVALO_MIN=1
SICAR_DB_HOST=192.168.1.67
SICAR_DB_PORT=3306
SICAR_DB_NAME=sicar
SICAR_DB_USER=
SICAR_DB_PASSWORD=

# --- Google Sheets (registro de entregas) ---
# Ver scripts/google-sheets/Codigo.gs. SHEETS_TOKEN: contraseña larga y aleatoria; SHEETS_URL: URL de la aplicación web.
SHEETS_TOKEN=
SHEETS_URL=

# --- IA de los agentes (Claude Haiku) ---
# Clave de https://console.anthropic.com (API Keys)
ANTHROPIC_API_KEY=

# --- Avisos a tu celular cuando algo se cae (opcional) ---
# 1) App gratis "ntfy" en el celular, suscríbete a un tema raro (ej. oficina-materiales-x7k2q9)
#    y pon aquí https://ntfy.sh/<ese tema>. Avisa si WhatsApp lleva AVISOS_MINUTOS sin conectar.
AVISOS_NTFY=
AVISOS_MINUTOS=10
# 2) Si la Oficina o la PC se apagan: cuenta gratis en https://healthchecks.io, crea un check
#    de "5 minutes" (gracia 10) y pega aquí su URL de ping. Si deja de latir, te avisa.
AVISOS_LATIDO_URL=

# --- Punto de Venta (en /pos/) ---
# Carpeta de datos del POS (por defecto data/pos)
# POS_DATOS=
